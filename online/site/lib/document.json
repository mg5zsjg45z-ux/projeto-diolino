"<!doctype html>\n<html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"theme-color\" content=\"#050806\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><title>Diolino.</title>\n<style>\n:root{color-scheme:light;--paper:#f8f8f6;--ink:#20201f;--line:#dcdcd7;--muted:#666662}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}main{max-width:1000px;margin:auto;padding:24px 20px 110px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:24px}.brand{font:42px Georgia,serif;letter-spacing:-2px}small,.muted{color:var(--muted);font-size:13px;line-height:1.6}.eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:10px;color:var(--muted)}h1{font:32px Georgia,serif;font-weight:400;margin:8px 0 20px}h2{font:24px Georgia,serif;font-weight:400}h3{font-size:16px;font-weight:500}button,input,select,textarea{font:inherit;border:1px solid var(--line);border-radius:8px;background:white;color:var(--ink);padding:12px;min-height:46px}button{cursor:pointer}button:disabled{opacity:.45;cursor:wait}button.primary{background:var(--ink);color:white;border-color:var(--ink)}button.quiet{background:transparent}input,select,textarea{width:100%}textarea{min-height:120px;resize:vertical}label{display:block;margin:16px 0 6px;font-size:13px;color:var(--muted)}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.row>*{flex:1;min-width:0}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{background:#fff;border:1px solid var(--line);padding:20px;border-radius:12px;margin-bottom:12px}.metric{font:32px Georgia,serif;margin:12px 0}.check{display:flex;align-items:center;gap:12px;padding:14px 0;margin:0;color:var(--ink);font-size:16px;border-bottom:1px solid #eee}.check input{width:22px;height:22px;min-height:22px;accent-color:#222}.check span{flex:1}.check small{display:block}.notice{padding:12px 14px;border-left:2px solid #333;background:#eeeee9;line-height:1.5;font-size:14px;margin:16px 0}.record{display:flex;justify-content:space-between;gap:12px;align-items:center}.record p{margin:5px 0;font-size:14px;color:var(--muted);white-space:pre-wrap;overflow-wrap:anywhere}.record button{flex-shrink:0}.hidden{display:none!important}nav{position:fixed;bottom:0;left:0;right:0;background:#f8f8f6f5;backdrop-filter:blur(15px);border-top:1px solid var(--line);display:flex;justify-content:center;padding:10px 8px calc(10px + env(safe-area-inset-bottom));gap:4px;z-index:2}nav button{border:0;background:transparent;font-size:12px;padding:10px;max-width:150px;flex:1}nav button.active{background:#222;color:white}#message{position:fixed;top:12px;left:5%;width:90%;background:#222;color:white;padding:14px;border-radius:8px;z-index:10;box-shadow:0 5px 30px #0002}dialog{width:min(640px,96vw);max-height:90dvh;border:1px solid var(--line);border-radius:14px;padding:24px;background:var(--paper)}dialog::backdrop{background:#0005}dialog header{position:sticky;top:-24px;background:var(--paper);padding-top:15px;z-index:1}.form-footer{display:flex;gap:8px;position:sticky;bottom:-24px;background:var(--paper);padding:16px 0 4px}.form-footer button{flex:1}svg{width:100%;height:150px}#login{max-width:430px;margin:10vh auto}#login .brand{font-size:64px}.divider{border:0;border-top:1px solid var(--line);margin:26px 0}.date{max-width:165px}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid #333;outline-offset:2px}@media(max-width:550px){main{padding:20px 16px 100px}.grid{grid-template-columns:1fr}.grid .card{padding:16px;display:flex;align-items:center;justify-content:space-between}.grid .metric{margin:0}.row>*{flex-basis:120px}h1{font-size:29px}.card{padding:16px}nav button{font-size:11px;padding:10px 5px}.brand{font-size:38px}}\n</style><link rel=\"stylesheet\" href=\"/mobile/modern.css\"><link rel=\"stylesheet\" href=\"/mobile/refinement.css\"><link rel=\"stylesheet\" href=\"/mobile/workspace.css\"><link rel=\"stylesheet\" href=\"/mobile/files.css\"><link rel=\"stylesheet\" href=\"/mobile/planner.css\"><link rel=\"stylesheet\" href=\"/mobile/terminal.css\"><link rel=\"stylesheet\" href=\"/mobile/library-browser.css\"><script>try{localStorage.removeItem('diolino-ms-client-id')}catch{}</script><link rel=\"stylesheet\" href=\"/mobile/matrix.css\"><link rel=\"icon\" href=\"/art/icons/house.svg\" type=\"image/svg+xml\"></head><body><div id=\"message\" role=\"status\" class=\"hidden\"></div><main>\n<section id=\"login\"><div class=\"eyebrow\">Controle pessoal · acesso privado</div><div class=\"brand\">Diolino.</div><p>Rotina, saúde e planejamento.</p><a href=\"/signin-with-chatgpt?return_to=/\" target=\"_top\">Entrar com ChatGPT</a><p class=\"muted\">Seus registros online ficam disponíveis no PC e no iPhone. Requer internet.</p><form id=\"login-form\" hidden><input id=\"code\"></form></section>\n<section id=\"app\" class=\"hidden\"><header><div><div class=\"eyebrow\">Controle pessoal · online</div><div class=\"brand\">Diolino.</div></div><button id=\"logout\" class=\"quiet\">Sair</button></header><div class=\"row\" style=\"margin-bottom:18px\"><div><div class=\"eyebrow\" id=\"area-label\">Visão geral</div><h1 id=\"title\">Painel geral</h1></div><input class=\"date\" id=\"day\" type=\"date\" aria-label=\"Data de referência\"></div>\n<section id=\"overview\"></section><section id=\"routine\" class=\"hidden\"></section>\n<section id=\"records\" class=\"hidden\"><div class=\"row\"><select id=\"kind\" aria-label=\"Tipo de registro\"></select><button id=\"new-record\" class=\"primary\">+ Novo registro</button></div><label class=\"check\"><input id=\"only-day\" type=\"checkbox\"><span>Mostrar somente a data selecionada</span></label><input id=\"search\" type=\"search\" placeholder=\"Buscar nos registros\" aria-label=\"Buscar registros\" style=\"margin:14px 0\"><div id=\"record-list\"></div></section>\n\n<section id=\"calculator\" class=\"hidden\"><p class=\"muted\">Simulação de Mifflin–St Jeor. Não é uma prescrição.</p><form id=\"energy-form\"><label>Peso (kg)</label><input name=\"weight\" inputmode=\"decimal\" required><label>Altura (cm)</label><input name=\"height\" inputmode=\"decimal\" required><label>Idade</label><input name=\"age\" inputmode=\"numeric\" required><label>Coeficiente da equação</label><select name=\"coefficient\"><option>Masculino (+5)</option><option>Feminino (−161)</option></select><label>Fator de atividade</label><input name=\"activity\" inputmode=\"decimal\" value=\"1,2\" required><label>Déficit simulado (%)</label><input name=\"deficit_pct\" inputmode=\"decimal\" value=\"0\" required><button class=\"primary\" style=\"margin-top:18px\">Calcular</button></form><div id=\"energy-result\"></div></section>\n</section></main><nav id=\"nav\" class=\"hidden\"><button data-page=\"overview\" class=\"active\">Visão geral</button><button data-page=\"routine\">Checagem</button><button data-page=\"records\">Registros</button><button data-page=\"calculator\">Calculadora</button></nav>\n<dialog id=\"editor\"><form id=\"record-form\"><header><h2 id=\"edit-title\"></h2><button type=\"button\" id=\"close-editor\" aria-label=\"Fechar\">×</button></header><div id=\"taco-box\" class=\"hidden\"><label>Buscar alimento na TACO</label><div class=\"row\"><input id=\"taco-query\" placeholder=\"Arroz, cozido\"><button type=\"button\" id=\"taco-search\">Buscar</button></div><select id=\"taco-results\" aria-label=\"Resultado da busca TACO\"><option value=\"\">Selecione um alimento</option></select></div><div id=\"fields\"></div><div id=\"form-error\" class=\"notice hidden\" role=\"alert\"></div><div class=\"form-footer\"><button type=\"button\" id=\"delete-record\">Excluir</button><button type=\"submit\" class=\"primary\" id=\"save-record\">Salvar registro</button></div></form></dialog>\n<script>\nlet csrf='',schema={},page='overview',rows=[],editing=null,tacoCode=null;\nconst $=id=>document.getElementById(id), fmt=n=>Number(n).toLocaleString('pt-BR',{maximumFractionDigits:1}), day=()=> $('day').value;\nconst el=(tag,text,cls)=>{let n=document.createElement(tag);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n};\nfunction notice(text){$('message').textContent=text;$('message').classList.remove('hidden');clearTimeout(notice.timer);notice.timer=setTimeout(()=>$('message').classList.add('hidden'),6500)}\nasync function api(path,data,raw=false){let options={credentials:'same-origin'};if(data!==undefined){options.method='POST';options.headers={'X-CSRF-Token':csrf,'Content-Type':raw?'application/octet-stream':'application/json'};options.body=raw?data:JSON.stringify(data)}let r=await fetch(path,options),j=await r.json();if(!r.ok){if(r.status===401){$('login').classList.remove('hidden');$('app').classList.add('hidden');$('nav').classList.add('hidden')}throw Error(j.error||'Não foi possível concluir.')}return j}\nfunction failure(error){notice(error.message||'Falha de conexão. Verifique sua internet e tente novamente.')}\nasync function initialize(){let s=await api('/api/session');csrf=s.csrf;schema=await api('/api/schema');$('kind').replaceChildren();for(let [key,spec] of Object.entries(schema)){let o=el('option',spec.label);o.value=key;$('kind').append(o)}$('login').classList.add('hidden');$('app').classList.remove('hidden');$('nav').classList.remove('hidden');await show('overview')}\n$('login-form').onsubmit=async e=>{e.preventDefault();try{let r=await api('/api/login',{code:$('code').value});csrf=r.csrf;$('code').value='';await initialize()}catch(error){failure(error)}};\n$('logout').onclick=()=>{location.href='/signout-with-chatgpt?return_to=/'};\nlet localNow=new Date();$('day').value=localNow.getFullYear()+'-'+String(localNow.getMonth()+1).padStart(2,'0')+'-'+String(localNow.getDate()).padStart(2,'0');\nasync function show(next){page=next;for(let name of ['overview','routine','records','calculator'])$(name).classList.toggle('hidden',name!==page);document.querySelectorAll('nav button').forEach(n=>n.classList.toggle('active',n.dataset.page===page));let names={overview:['Visão geral','Painel geral'],routine:['Checagem diária','Status diário'],records:['Seus registros','Consulta de registros'],calculator:['Saúde','Simulação calórica.']};$('area-label').textContent=names[page][0];$('title').textContent=names[page][1];if(page==='overview'||page==='routine')await overview();if(page==='records')await records()}\ndocument.querySelectorAll('nav button').forEach(n=>n.onclick=()=>show(n.dataset.page).catch(failure));$('day').onchange=()=>{if(day())show(page).catch(failure)};\nfunction metric(label,value){let card=el('div',undefined,'card');card.append(el('small',label),el('div',value,'metric'));return card}\nfunction check(label,detail,key,checked){let l=el('label',undefined,'check'),input=el('input');input.type='checkbox';input.checked=checked;let span=el('span',label);if(detail)span.append(el('small',detail));l.append(input,span);input.onchange=async()=>{input.disabled=true;try{await api('/api/check',{day:day(),key,checked:input.checked});await overview()}catch(error){input.checked=!input.checked;failure(error)}finally{input.disabled=false}};return l}\nasync function overview(){let data=await api('/api/overview?day='+day()),s=data.summary,c=data.checks;$('overview').replaceChildren();$('routine').replaceChildren();let grid=el('div',undefined,'grid');grid.append(metric('Pilares confirmados',Object.values(data.pillars).filter(p=>p.done).length+' / 3'),metric('Água registrada',fmt(c.water_ml)+' mL'),metric('Sono registrado',s.sleep_count?fmt(s.sleep_min/60)+' h':'–'));$('overview').append(grid);let pillars=el('div',undefined,'card');pillars.append(el('h2','Os três pilares'));let labels={medicine_status:'Medicina · 60 minutos',exercise_status:'Exercício · 40 minutos',bible_status:'Estudo bíblico'};for(let [key,p] of Object.entries(data.pillars))pillars.append(check(labels[key],p.known?p.source:'–',key,p.done));$('routine').append(pillars);let habits=el('div',undefined,'card');habits.append(el('h2','Cuidados do dia'));for(let [label,keys] of data.check_groups)for(let [index,key] of keys.entries())habits.append(check(label+' · '+(index+1)+'ª checagem','',key,(c.record||{})[key]===1));habits.append(el('p',c.water_target_ml?'Água: '+fmt(c.water_ml)+' / '+fmt(c.water_target_ml)+' mL · meta pessoal de 50 mL/kg.':'Cadastre seu peso para exibir a meta pessoal de água.','muted'));$('routine').append(habits);let btn=el('button','Abrir checagem diária','primary');btn.onclick=()=>show('routine').catch(failure);$('overview').append(btn);let upcoming=el('div',undefined,'card');upcoming.append(el('h2','Próximos compromissos'));if(!data.upcoming.length)upcoming.append(el('p','Nenhum compromisso registrado.','muted'));for(let r of data.upcoming){let box=el('div');box.append(el('h3',r.title),el('p',dateLabel(r.date)+' · '+(r.time||'Dia inteiro'),'muted'));upcoming.append(box)}$('overview').append(el('hr',undefined,'divider'),upcoming);if(data.weight_series.length){let card=el('div',undefined,'card');card.append(el('h2','Evolução do peso'));let points=data.weight_series,ys=points.map(p=>p[1]),min=Math.min(...ys)-1,max=Math.max(...ys)+1,ns='http://www.w3.org/2000/svg',svg=document.createElementNS(ns,'svg');svg.setAttribute('viewBox','0 0 600 150');svg.setAttribute('role','img');svg.setAttribute('aria-label','Evolução do peso, de '+fmt(ys[0])+' a '+fmt(ys.at(-1))+' kg');let line=document.createElementNS(ns,'polyline');line.setAttribute('points',points.map((p,i)=>(20+i*560/Math.max(1,points.length-1))+','+(130-(p[1]-min)/(max-min)*110)).join(' '));line.setAttribute('fill','none');line.setAttribute('stroke','#222');line.setAttribute('stroke-width','2');svg.append(line);card.append(svg,el('p',dateLabel(points[0][0])+' a '+dateLabel(points.at(-1)[0])+' · último peso '+fmt(ys.at(-1))+' kg','muted'));$('overview').append(card)}}\nfunction dateLabel(value){return value?value.split('-').reverse().join('/'):''}\nasync function records(){rows=await api('/api/records?kind='+$('kind').value+'&day='+day()+($('only-day').checked?'&filter=day':''));drawRows()}\nfunction drawRows(){let list=$('record-list');list.replaceChildren();let query=$('search').value.toLocaleLowerCase('pt-BR'),filtered=rows.filter(r=>Object.values(r).join(' ').toLocaleLowerCase('pt-BR').includes(query));list.append(el('p',filtered.length+' registro(s)','muted'));for(let r of filtered){let card=el('div',undefined,'card record'),body=el('div'),kind=$('kind').value,spec=schema[kind],title=r.title||r.food_name||r.topic||r.passage||r.drink||r.exercise||r.name||spec.label;body.append(el('h3',title));let detail=spec.fields.filter(f=>r[f.key]!==null&&r[f.key]!==''&&f.key!=='description'&&f.key!=='notes').slice(0,6).map(f=>f.type==='date'?dateLabel(r[f.key]):f.label+': '+r[f.key]).join(' · ');body.append(el('p',detail));if(r._readonly)body.append(el('small','Recorrência: edição no Calendário da Apple'));let b=el('button','Abrir');b.onclick=()=>openEditor(kind,r);card.append(body,b);list.append(card)}}\n$('kind').onchange=()=>records().catch(failure);$('only-day').onchange=()=>records().catch(failure);$('search').oninput=drawRows;$('new-record').onclick=()=>openEditor($('kind').value,{});\nfunction openEditor(kind,values){editing={kind,id:values.id||null,readonly:values._readonly};tacoCode=null;$('fields').replaceChildren();$('form-error').classList.add('hidden');$('edit-title').textContent=schema[kind].label;$('delete-record').classList.toggle('hidden',!editing.id||!!editing.readonly);$('save-record').disabled=!!editing.readonly;$('taco-box').classList.toggle('hidden',kind!=='food');$('taco-results').replaceChildren(el('option','Selecione um alimento'));$('taco-results').firstChild.value='';for(let f of schema[kind].fields){let id='f-'+f.key,label=el('label',f.label+(f.required?' *':''));label.htmlFor=id;let input;if(f.type==='choice'||f.type==='workout'||f.type==='plan'){input=el('select');let blank=el('option','Não informado');blank.value='';input.append(blank);if(f.type==='choice')for(let choice of f.choices){let o=el('option',choice);o.value=choice;input.append(o)}else{let current=values[f.key];if(current){let o=el('option','Treino #'+current);o.value=current;input.append(o)}api('/api/records?kind='+(f.type==='plan'?'plans':'workout')).then(rs=>{if(!input.isConnected)return;input.replaceChildren(blank);for(let r of rs){let o=el('option',f.type==='plan'?r.title:dateLabel(r.date)+' · '+r.name);o.value=r.id;input.append(o)}input.value=current||''}).catch(failure)}}else if(f.type==='long'){input=el('textarea')}else{input=el('input');input.type=f.type==='date'?'date':f.type==='time'?'time':f.type==='datetime'?'datetime-local':'text';if(f.type==='number')input.inputMode='decimal';if(f.type==='integer')input.inputMode='numeric'}input.id=id;input.name=f.key;input.required=f.required;input.disabled=!!editing.readonly;let value=values[f.key]??(f.key==='date'?day():'');input.value=f.type==='datetime'?String(value).replace(' ','T'):value;$('fields').append(label,input)}$('editor').showModal()}\n$('close-editor').onclick=()=>$('editor').close();$('editor').addEventListener('cancel',()=>{editing=null});\n$('record-form').onsubmit=async e=>{e.preventDefault();if(!editing||editing.readonly)return;let button=$('save-record');button.disabled=true;try{let values={};for(let f of schema[editing.kind].fields){let value=$('f-'+f.key).value;values[f.key]=f.type==='datetime'?value.replace('T',' '):value}await api('/api/save',{kind:editing.kind,id:editing.id,values,taco_code:tacoCode});$('editor').close();notice('Registro salvo na sua conta online.');if(page==='records')await records()}catch(error){$('form-error').textContent=error.message;$('form-error').classList.remove('hidden')}finally{button.disabled=false}};\n$('delete-record').onclick=async()=>{if(!editing||!editing.id||!confirm('Excluir este registro? O histórico será preservado.'))return;try{await api('/api/delete',{kind:editing.kind,id:editing.id});$('editor').close();await records();notice('Registro removido da lista ativa.')}catch(error){failure(error)}};\nlet tacoFoods=[];$('taco-search').onclick=async()=>{try{tacoFoods=await api('/api/taco?q='+encodeURIComponent($('taco-query').value));$('taco-results').replaceChildren(el('option','Selecione um alimento'));$('taco-results').firstChild.value='';for(let f of tacoFoods){let o=el('option',f.name);o.value=f.code;$('taco-results').append(o)}}catch(error){failure(error)}};\n$('taco-results').onchange=()=>{tacoCode=$('taco-results').value||null;let food=tacoFoods.find(f=>String(f.code)===tacoCode);if(food){$('f-food_name').value=food.name;$('f-source').value='TACO (NEPA/UNICAMP)';$('f-unit').value='g';notice('Informe a quantidade em gramas. Os nutrientes serão calculados ao salvar.')}};\n$('energy-form').onsubmit=async e=>{e.preventDefault();try{let result=await api('/api/energy',Object.fromEntries(new FormData(e.target)));$('energy-result').replaceChildren(el('hr',undefined,'divider'));for(let [key,label]of Object.entries({resting_kcal:'Repouso estimado',total_kcal:'Gasto total estimado',deficit_kcal:'Déficit simulado',intake_kcal:'Ingestão simulada'}))$('energy-result').append(metric(label,fmt(result[key])+' kcal'))}catch(error){failure(error)}};\nwindow.addEventListener('load',()=>initialize().catch(error=>{if(!error.message.includes('código'))console.debug('Aguardando autenticação.')}));\n</script><script src=\"/mobile/planning.js\"></script><script src=\"/mobile/online.js\"></script><script src=\"/mobile/refinement.js\"></script><script src=\"/mobile/workspace.js\"></script><script src=\"/mobile/document-preview.js\"></script><script src=\"/mobile/library-browser.js\"></script><script src=\"/mobile/files.js\"></script><script src=\"/mobile/planner.js\"></script><script src=\"/mobile/pomodoro.js\"></script><script src=\"/mobile/matrix.js\"></script><script src=\"/mobile/device-sync.js\"></script></body></html>"